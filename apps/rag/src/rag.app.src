{application, rag, [
    {description, "Shared root + notation for the mcl-rag service's umbrella apps"},
    {vsn, "0.3.2"},
    {registered, [rag_store]},
    {mod, {rag_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        cowboy,
        jsx,
        %% barrel brings barrel_docdb, the store's document half.
        barrel,
        %% rag_embed_mcl_embedder implements its barrel_embed_provider.
        barrel_embed
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]}
]}.
