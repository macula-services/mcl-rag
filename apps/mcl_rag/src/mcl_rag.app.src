{application, mcl_rag, [
    {description, "The mesh shared memory: retrieval over a realm-bound corpus, and the deposits agents remember into it"},
    {vsn, "0.1.0"},
    {registered, [mcl_rag_sup, mcl_rag_mesh_rpc, corpus_git_sync, refresh_corpus_scheduler]},
    {mod, {mcl_rag_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        inets,
        ssl,
        cowboy,
        %% mcl_rag_sup builds the HTTP listener's child spec itself.
        ranch,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om,
        %% The org's federated retrieval (join_federation). Unlisted, relx
        %% leaves it out of the release and joining is `undef'.
        macula_rag,
        barrel,
        %% The slices, started before this app.
        rag,
        embed_corpus,
        refresh_corpus,
        serve_retrieval,
        query_chunks,
        query_sources
    ]},
    {env, [
        %% The local HTTP API. Loopback: it has writes and no authentication.
        {http_port, 8451},
        {http_ip, "127.0.0.1"}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-rag"}]}
]}.
