{application, embed_corpus, [
    {description, "Embed corpus documents into vectors (CMD)"},
    {vsn, "0.1.3"},
    {registered, []},
    {mod, {embed_corpus_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        cowboy,
        %% evoq_command is the desks' command behaviour. No event store: the
        %% service exports no store_id/0, so reckon_db and reckon_evoq are
        %% not this app's (mcl_om still lists them; mcl-om's to fix).
        evoq,
        rag
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]}
]}.
