%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_rag.
%%
%% The mesh shared memory: retrieval over a realm-bound corpus, and the deposits agents remember into it
%%
%% An umbrella of seven apps: rag (the barrel store and the embedder client),
%% embed_corpus, refresh_corpus and serve_retrieval (the write and retrieval
%% desks), query_chunks and query_sources (the read desks), and mcl_rag (the
%% service: mesh procedures, the local HTTP API, corpus sync).

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate. 0.27: it no longer brings barrel_docdb (so
    %% rocksdb), and a boot claim carries the MCL_SERVICE_NAME / MCL_BOX labels.
    {mcl_om, "~> 0.28"},
    %% Declared directly: the desks call macula themselves.
    {macula, "~> 12.2"},
    %% Federated retrieval: this node answers other shards' fan-out queries.
    {macula_rag, "~> 0.1"},
    %% The document and vector store. The shared memory on disk was written by
    %% barrel 1.3.1 and read back identically through barrel_docdb 1.5.0 (the
    %% continuity probe, 2026-09-23), so this floor and that pair are the ones
    %% the data is known to open with.
    {barrel, "~> 1.3.1"},
    %% The store's document half, declared by us: mcl_om stopped bringing it
    %% in 0.27.0. barrel brings the erlang rocksdb binding; see the override.
    {barrel_docdb, "~> 1.5"},
    %% The local HTTP API's listener.
    {cowboy, "~> 2.12"},
    %% The desks declare evoq_command; 1.24 marks replay.
    {evoq, "~> 1.24"}
]}.

%% The corpus-sync NIF (Rust, vendored libgit2) is built wherever this compiles:
%% locally, in CI and in the image. It lands in apps/mcl_rag/priv/lib, where
%% mcl_rag_corpus_sync_nif loads it from.
{pre_hooks, [{compile, "bash scripts/build-corpus-sync-nif.sh"}]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% ⚠ ROCKSDB LINKS THE SYSTEM LIBRARY. The rocksdb binding's pre_hook would
%% otherwise compile the RocksDB it bundles, tens of minutes of CPU in every
%% CI run, image build and local test. With `-DWITH_SYSTEM_ROCKSDB=ON' it links
%% librocksdb 11.1.x instead, the release rocksdb 3.1.2 is written against,
%% which no distribution packages: build in macula-ci-otp-rocksdb and run on
%% macula-pq-runtime-rocksdb (both pinned by digest in lint.yml and the
%% Containerfile). Without the library the build stops at configure with
%% "Could not find RocksDB", on purpose. An override replaces the whole key,
%% so the binding's clean hooks are repeated.
{overrides, [
    {override, rocksdb, [
        {pre_hooks, [
            {clean, "rm -f priv/*.so"},
            {clean, "rm -rf _build/cmake"},
            {"(linux|darwin|solaris)", compile,
             "./do_cmake.sh -DWITH_SYSTEM_ROCKSDB=ON $ERLANG_ROCKSDB_OPTS"},
            {"(freebsd|netbsd|openbsd)", compile,
             "./do_cmake.sh -DWITH_SYSTEM_ROCKSDB=ON $ERLANG_ROCKSDB_OPTS"}
        ]}
    ]}
]}.

{relx, [
    {release, {mcl_rag, "0.1.0"}, [rag, embed_corpus, refresh_corpus, serve_retrieval,
                                   query_chunks, query_sources, mcl_rag, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% meck stands in for the mesh and the store where a test needs to see
    %% exactly what a desk hands on.
    %% cth_skip_is_failure (macula_testkit): a skip nobody allowed fails the
    %% run, because `rebar3 ct' exits 0 on a case that skipped itself (macula#43).
    {test, [{deps, [{meck, "~> 1.2"}, {macula_testkit, "~> 0.2"}]},
            {ct_opts, [{sys_config, ["config/test.sys.config"]},
                       {ct_hooks, [cth_skip_is_failure]}]},
            {eunit_opts, [{sys_config, "config/test.sys.config"}]}]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
