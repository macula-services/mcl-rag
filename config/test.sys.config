%% The test environment: the whole mcl_rag application starts in CT, and with
%% it mcl_om and macula 14, with no stations (the mesh stays dark).
[
    {kernel, [{logger_level, warning}]},
    {mcl_rag, [
        {http_port,   18451},
        {http_ip,     "127.0.0.1"},
        {data_dir,    "_build/test/mcl-rag-data"},
        %% A deterministic embedder (test/rag_embed_stub.erl), so the pipeline
        %% suites run on every machine instead of skipping without ollama. It
        %% proves the pipeline, not retrieval quality.
        {embed_provider, {rag_embed_stub, #{dimension => 384}}},
        {embed_dim,      384},
        {embed_model,    <<"macula/multilingual-e5-small:f16">>},
        %% No operators: the suites call the desks directly, and the gate has
        %% its own tests.
        {operators, ""}
    ]},
    {mcl_om, [
        {health_port,       18450},
        {identity_key_path, "_build/test/mcl_om_identity.key"},
        %% The release's own org (config/sys.config.src). mcl_om 0.27.1 and
        %% later refuse to boot a service without one, so without it every CT
        %% suite stops in init_per_suite.
        {org,               <<"mcl-rag">>}
    ]},
    {macula, [
        %% ⚠ THE SUITE'S OWN IDENTITIES, NOT THE MACHINE'S. Unset, macula
        %% reads (and on a fresh machine writes) the operator's own user
        %% data directory. macula 14 keys identities by name and profile
        %% under this directory and refuses the old node_identity_path.
        {identity_dir, "_build/test/identity"},
        {crypto_profile, pq_hybrid}
    ]}
].
