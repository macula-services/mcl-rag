%% The test environment: the whole mcl_rag application starts in CT, and with
%% it mcl_om and macula 12, with no stations (the mesh stays dark).
[
    {kernel, [{logger_level, warning}]},
    {mcl_rag, [
        {http_port,   18451},
        {http_ip,     "127.0.0.1"},
        {data_dir,    "_build/test/mcl-rag-data"},
        %% The suites embed through ollama (or mock the embedder), not the mesh.
        {embed_url,   <<"http://127.0.0.1:11434">>},
        {embed_model, <<"nomic-embed-text">>},
        {embed_dim,   768}
    ]},
    {mcl_om, [
        {health_port,       18450},
        {identity_key_path, "_build/test/mcl_om_identity.key"}
    ]},
    {macula, [
        %% ⚠ THE SUITE'S OWN IDENTITY, NOT THE MACHINE'S. Unset, macula 12
        %% reads (and on a fresh machine writes) the operator's own
        %% basedir(user_data, "macula")/identity.key.
        {node_identity_path, "_build/test/node_identity.key"},
        {crypto_profile, pq_hybrid}
    ]}
].
